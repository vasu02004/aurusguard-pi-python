MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
BRANCH_ID=

SERIAL_PORT_PATH=
BAUDRATE=
# Frame terminator the scale sends (optional — default \n). Use \x1b for ESC-terminated
# protocols (e.g. Aczet indicators).
SERIAL_DELIMITER=

# Live-weight streaming tuning (both optional — defaults shown)
STREAM_INTERVAL_MS=1500   # publish interval in ms (1–2 s range)
STREAM_CEILING_MS=180000  # hard-stop fallback if STOP_STREAM is never received (3 min)
